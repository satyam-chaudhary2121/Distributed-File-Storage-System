# Copy to your shell environment (or a process manager) - values here are examples, not secrets.
# Shared secret for coordinator <-> node authentication. Use a long random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
DFS_CLUSTER_SECRET=replace-with-a-long-random-value

# Optional overrides (any key from config.yaml, uppercased, prefixed with DFS_)
# DFS_CONFIG=config.yaml
# DFS_REPLICATION_FACTOR=3
# DFS_CHUNK_SIZE=1048576
# DFS_COORDINATOR_PORT=8000
# DFS_LOG_LEVEL=INFO
